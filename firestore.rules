rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A group's members map is keyed by uid, so membership check is a map
    // key lookup. Only members can read/update a group; anyone signed in
    // can create one (and must add themselves as a member when doing so).
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      // An existing member can update anything. Someone who ISN'T yet a
      // member can only join by code — a write that adds nothing but their
      // own entry to `members` and touches no other field — never remove
      // or change anyone else, or edit the group's other fields.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        )
      );
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow delete: if false;

      // Viewers can see a group's list and pantry but not change them —
      // "Viewer: see only" per the role matrix.
      function isMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
      function isNotViewer() {
        return get(/databases/$(database)/documents/groups/$(groupId))
          .data.members[request.auth.uid].role != 'viewer';
      }

      match /items/{itemId} {
        allow read: if isMember();
        allow write: if isMember() && isNotViewer();
      }

      match /pantry/{itemId} {
        allow read: if isMember();
        allow write: if isMember() && isNotViewer();
      }

      match /activity/{entryId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      match /reminders/{reminderId} {
        allow read: if isMember();
        allow write: if isMember() && isNotViewer();
      }
    }

    // Maps a short invite code -> groupId so a joining user can look up
    // which group to join without being able to list/browse all groups.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
